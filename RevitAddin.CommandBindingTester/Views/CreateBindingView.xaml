<Window x:Class="RevitAddin.CommandBindingTester.Views.CreateBindingView"
	d:DataContext="{d:DesignInstance Type=vms:CreateBindingViewModel}"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
	xmlns:local="clr-namespace:RevitAddin.CommandBindingTester.Views"
    xmlns:vms="clr-namespace:RevitAddin.CommandBindingTester.ViewModels"
    Title="{Binding Title}"
	mc:Ignorable="d" 
	>

    <StackPanel Margin="15">
        <DataGrid Name="dataGrid" Height="560" Width="900" Margin="0 0 0 8" ItemsSource="{Binding Models}" />
        <Button Height="24" Command="{Binding Command}">Click Me!</Button>
    </StackPanel>
</Window>
