<Window x:Class="RevitAddin.CommandBindingTester.Views.CreateBindingView"
	d:DataContext="{d:DesignInstance Type=vms:CreateBindingViewModel}"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
	xmlns:local="clr-namespace:RevitAddin.CommandBindingTester.Views"
    xmlns:vms="clr-namespace:RevitAddin.CommandBindingTester.ViewModels"
    Title="{Binding Title}"
	mc:Ignorable="d" 
	>

    <StackPanel Margin="15">
        <DataGrid Name="dataGrid" Height="560" Width="900" Margin="0 0 0 8" ItemsSource="{Binding Models}" local:DataGridSelectedCellBinding.SelectedItem="{Binding SelectedItem, Mode=TwoWay}"  />
        <Grid>
            <StackPanel Orientation="Horizontal">
                <Button Height="24" Width="80" Command="{Binding Command}">Create</Button>
                <Button Height="24" Width="80" Margin="8 0 0 0" Command="{Binding CommandDelete}">Delete</Button>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Height="24" Width="80" IsDefault="True" Command="{Binding CommandResult}">OK</Button>
                <Button Height="24" Width="80" Margin="8 0 0 0" IsCancel="True">Cancel</Button>
            </StackPanel>
        </Grid>
    </StackPanel>
</Window>
